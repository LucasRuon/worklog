# As variáveis são lidas do ambiente do processo. Este arquivo não é carregado automaticamente.
WORKLOG_PORT=4320
# Opcional: diretório exclusivo fora de repositórios monitorados.
# Padrão macOS: ~/Library/Application Support/Worklog
# Padrão Linux: $XDG_DATA_HOME/worklog ou ~/.local/share/worklog
# WORKLOG_DATA_DIR=/caminho/absoluto/fora/dos/repositorios
# Nenhum token deve ser colocado neste arquivo.
